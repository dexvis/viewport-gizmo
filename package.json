{
  "name": "@dexvis/viewport-gizmo",
  "version": "0.1.0",
  "description": "Interactive camera-orientation cube for three.js viewports. Fork of three-viewport-gizmo: cube-only, WebGPURenderer support, configurable view orientations (HENP/CAD axis conventions), roll and home controls.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "build:check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dexvis/viewport-gizmo.git"
  },
  "keywords": [
    "three",
    "threejs",
    "gizmo",
    "viewport",
    "camera",
    "navigation",
    "cube",
    "webgpu"
  ],
  "author": "dexvis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dexvis/viewport-gizmo/issues"
  },
  "homepage": "https://github.com/dexvis/viewport-gizmo#readme",
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
